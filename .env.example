# Local demo configuration. Replace the admin token before using the dashboard.
DB_PATH=./runtime/atithi.sqlite3
ADMIN_TOKEN=replace-with-a-long-random-local-token

# Optional browser voice providers. Empty values keep external calls disabled.
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_VOICE=Shivani
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALLOW_RULE_BASED_DEMO=true

# Optional Twilio turn-based bridge. Requires public HTTPS and account setup.
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MANAGER_PHONE=
